# Binaries and build output
/bin/
/kroot
/dist/
/build/
*.exe
*.test
*.out

# Local scratch: tool install logs and temporary files
/.tmp/

# Node tooling (repository-level and, later, the web/ workspace)
node_modules/

# Environment and secrets (never commit)
.env
.env.*
!.env.example

# Coverage reports
coverage.out
coverage.html

# macOS
.DS_Store

# Editors / IDEs
.idea/
.vscode/
*.swp

# Build tooling.
#
# Some developer machines carry a `Makefile` rule in their global ignore file
# (the qmake/Qt one, `core.excludesFile`). That rule silently kept this
# repository's own Makefile out of version control, so a fresh clone had no
# `make` entry point at all. A local `.gitignore` takes precedence over the
# global file, so re-including it here makes the repository immune to that trap.
!Makefile

